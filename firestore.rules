rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myUser().data.role == "admin";
    }

    function isBarber() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myUser().data.role == "barber"
        && myUser().data.active == true;
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    match /publicBarbers/{barberId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /chairs/{chairId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /sales/{saleId} {
      allow read: if isAdmin()
        || (isBarber() && resource.data.barberId == request.auth.uid);

      allow create, update, delete: if isAdmin();
    }


    match /bookedSlots/{slotId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.slotId == slotId
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/publicBarbers/$(request.resource.data.barberId))
        && get(/databases/$(database)/documents/publicBarbers/$(request.resource.data.barberId)).data.active == true;

      allow update: if isAdmin()
        || (
          isBarber()
          && resource.data.barberId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
          && request.resource.data.status in ["confirmed", "completed", "cancelled"]
          && request.resource.data.updatedAt == request.time
        )
        || (
          signedIn()
          && resource.data.status == "cancelled"
          && request.resource.data.slotId == slotId
          && request.resource.data.barberId == resource.data.barberId
          && request.resource.data.date == resource.data.date
          && request.resource.data.time == resource.data.time
          && request.resource.data.status == "pending"
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && exists(/databases/$(database)/documents/publicBarbers/$(request.resource.data.barberId))
          && get(/databases/$(database)/documents/publicBarbers/$(request.resource.data.barberId)).data.active == true
        );

      allow delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.slotId == appointmentId
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/publicBarbers/$(request.resource.data.barberId))
        && get(/databases/$(database)/documents/publicBarbers/$(request.resource.data.barberId)).data.active == true
        && exists(/databases/$(database)/documents/services/$(request.resource.data.serviceId))
        && get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.active == true;

      allow read: if isAdmin()
        || (isBarber() && resource.data.barberId == request.auth.uid)
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow update: if isAdmin()
        || (
          isBarber()
          && resource.data.barberId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
          && request.resource.data.status in ["confirmed", "completed", "cancelled"]
          && request.resource.data.updatedAt == request.time
        )
        || (
          signedIn()
          && resource.data.status == "cancelled"
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.slotId == appointmentId
          && request.resource.data.barberId == resource.data.barberId
          && request.resource.data.date == resource.data.date
          && request.resource.data.time == resource.data.time
          && request.resource.data.status == "pending"
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && exists(/databases/$(database)/documents/publicBarbers/$(request.resource.data.barberId))
          && get(/databases/$(database)/documents/publicBarbers/$(request.resource.data.barberId)).data.active == true
          && exists(/databases/$(database)/documents/services/$(request.resource.data.serviceId))
          && get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.active == true
        )
        || (
          signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
          && request.resource.data.status == "cancelled"
          && request.resource.data.updatedAt == request.time
        );

      allow delete: if isAdmin();
    }
  }
}
